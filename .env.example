# Admin authentication (server-side only; all three values are required).
# Generate the versioned salted hash with: npm run auth:hash
# Store the generated hash in the deployment secret manager; never configure a
# plaintext ADMIN_PASSWORD or commit a real credential.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
ADMIN_PRINCIPAL_ID=legacy-admin:admin
# Optional multi-account registry. When non-empty it replaces the three legacy
# account identity fields above. Password hashes use the same auth:hash format;
# principalId must already exist in D1 with an active role grant.
ADMIN_ACCOUNTS_JSON=
# At least 32 characters. Rotating this value invalidates existing sessions.
ADMIN_SESSION_SECRET=
# At least 32 UTF-8 bytes. HMACs normalized client/account limiter identities;
# never expose it to the browser or reuse it as an admin/session credential.
RATE_LIMIT_KEY_SECRET=

# Cloudflare D1 is not configured through a DATABASE_URL. The runtime expects a
# D1 binding named DB, declared by .openai/hosting.json / the deployment control
# plane.

# Evidence-bound AI composer and allowed-source web fallback (US-026, US-027).
# /api/chat may call web search only after local/RAG no-match and only when
# AI_WEB_SEARCH_ENABLED is exactly true. Keep flags false until privacy,
# under-18, budget/rate-limit and rollout review pass.
# Store OPENAI_API_KEY only in a server-side secret manager.
OPENAI_API_KEY=
# Direct web-search accepts any syntactically valid OpenAI model ID.
OPENAI_MODEL=gpt-5.4-mini
AI_REPHRASE_ENABLED=false
AI_SHADOW_ENABLED=false
# Direct fallback searches only a server-owned Government allowlist. Thư Viện
# Pháp Luật is reserved for separate backoffice discovery and cannot be a final
# citation.
AI_WEB_SEARCH_ENABLED=false
# Global UTC-day ceiling. Each request reserves the second value before calling
# the provider and reconciles actual usage afterwards.
AI_WEB_SEARCH_DAILY_TOKEN_BUDGET=500000
AI_WEB_SEARCH_RESERVATION_TOKENS=12000
AI_PROVIDER_TIMEOUT_MS=10000
AI_PROVIDER_MAX_REQUESTS_PER_MINUTE=30
AI_SHADOW_MAX_CASES=5

# Planned official-source ingestion (US-023, US-024)
# SOURCE_PROVIDER_API_KEY and CRON_SECRET are server-side secrets.
# SOURCE_PROVIDER_BASE_URL must match an approved source-registry entry and
# never expands the versioned host allowlist.
# Leave INGESTION_ENABLED=false until the source registry is approved and the
# ingestion worker, raw snapshot store, quarantine and four-eyes flow exist.
INGESTION_ENABLED=false
SOURCE_PROVIDER_BASE_URL=
SOURCE_PROVIDER_API_KEY=
SOURCE_FETCH_USER_AGENT=
INGESTION_TIMEOUT_MS=15000
INGESTION_MAX_DOC_BYTES=10485760
CRON_SECRET=

# Cloudflare platform bindings are configured in the deployment control plane,
# not as .env values:
# - DB: D1 database
# - RAW_DOCUMENTS: R2 bucket for immutable source snapshots
# - INGESTION_QUEUE: Queue for batch/retry work
# - INGESTION_DLQ: dead-letter queue

# Not currently supported by runtime code:
# AI_GATEWAY_API_KEY=
# VERCEL_OIDC_TOKEN=
# AI_GATEWAY_MODEL=
# DATABASE_URL=
# DATABASE_URL_UNPOOLED=
# BLOB_READ_WRITE_TOKEN=
