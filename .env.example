# Neon PostgreSQL (Vercel Marketplace)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Private Vercel Blob store for original legal-source snapshots
BLOB_READ_WRITE_TOKEN=

# Admin authentication (server-side only)
# Store a scrypt hash here, never a plaintext password.
ADMIN_PASSWORD_HASH=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_SESSION_SECRET=

# OpenAI Responses API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.0
AI_GATEWAY_MODEL=openai/gpt-5.6-sol

# Protect scheduled source-verification jobs
CRON_SECRET=
