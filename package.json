{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:ai-adapter": "node --experimental-strip-types --test tests/openai-evidence.test.mjs",
    "test:ai-shadow": "node --test tests/ai-shadow.test.mjs",
    "test:web-search": "node --experimental-strip-types --test tests/openai-web-search.test.mjs",
    "test:web-candidates": "node --experimental-strip-types --test tests/web-search-candidates.test.mjs",
    "test:retriever": "node --experimental-strip-types --test tests/legal-evidence-retriever.test.mjs",
    "test:admin-auth": "node --experimental-strip-types --test tests/admin-auth.test.mjs",
    "test:rate-limit": "node --experimental-strip-types --test tests/rate-limit.test.mjs",
    "test:telemetry": "node --experimental-strip-types --test tests/telemetry.test.mjs",
    "test:ingestion-local": "node --experimental-strip-types --test tests/ingestion-local.test.mjs",
    "test:image-intent": "node --experimental-strip-types --test tests/image-intent.test.mjs",
    "test:showcase": "node --test tests/public-showcase.test.mjs",
    "test:catalog-resolver": "node --test tests/catalog-resolver.test.mjs",
    "smoke:ai": "node --env-file=.env.local --experimental-strip-types scripts/smoke-openai-evidence.mjs",
    "smoke:web-search": "node --env-file=.env.local --experimental-strip-types scripts/smoke-openai-web-search.mjs",
    "shadow:ai": "node --env-file=.env.local --experimental-strip-types scripts/shadow-openai-evidence.mjs",
    "auth:hash": "node --experimental-strip-types scripts/generate-admin-password-hash.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "^16.2.10",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.44.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "^8.1.4",
    "wrangler": "^4.110.0"
  },
  "type": "module"
}
