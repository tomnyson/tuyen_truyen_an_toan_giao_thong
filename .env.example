# Admin authentication (server-side only; all three values are required)
# ADMIN_PASSWORD is currently read as plaintext by the runtime. Store it only
# in the deployment secret manager; never commit a real password.
# Do not use admin/admin or another default credential in production.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# At least 32 characters. Rotating this value invalidates existing sessions.
ADMIN_SESSION_SECRET=

# Cloudflare D1 is not configured through a DATABASE_URL. The runtime expects a
# D1 binding named DB, declared by .openai/hosting.json / the deployment control
# plane.

# Not currently used by runtime code:
# AI provider access is disabled until responses are bound to a validated
# retrieval evidence bundle (DEC-002).
# OPENAI_API_KEY=
# OPENAI_MODEL=
# AI_GATEWAY_API_KEY=
# VERCEL_OIDC_TOKEN=
# AI_GATEWAY_MODEL=
# DATABASE_URL=
# DATABASE_URL_UNPOOLED=
# BLOB_READ_WRITE_TOKEN=
# ADMIN_PASSWORD_HASH=
# CRON_SECRET=
